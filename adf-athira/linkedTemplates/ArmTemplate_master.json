{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-athira"
		},
		"datalakeDL_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'datalakeDL'"
		},
		"sqlDL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sqlDL'"
		},
		"datalakeDL_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfathirastaccount.dfs.core.windows.net/"
		},
		"sqlDL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqldbathira.database.windows.net"
		},
		"sqlDL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adfdatabase"
		},
		"sqlDL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "athira"
		},
		"EventTrigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/a490b77c-69d7-4e67-8444-09e353eb260a/resourceGroups/MyRG/providers/Microsoft.Storage/storageAccounts/adfathirastaccount"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-athira_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"datalakeDL_accountKey": {
						"value": "[parameters('datalakeDL_accountKey')]"
					},
					"sqlDL_password": {
						"value": "[parameters('sqlDL_password')]"
					},
					"datalakeDL_properties_typeProperties_url": {
						"value": "[parameters('datalakeDL_properties_typeProperties_url')]"
					},
					"sqlDL_properties_typeProperties_server": {
						"value": "[parameters('sqlDL_properties_typeProperties_server')]"
					},
					"sqlDL_properties_typeProperties_database": {
						"value": "[parameters('sqlDL_properties_typeProperties_database')]"
					},
					"sqlDL_properties_typeProperties_userName": {
						"value": "[parameters('sqlDL_properties_typeProperties_userName')]"
					},
					"EventTrigger_properties_typeProperties_scope": {
						"value": "[parameters('EventTrigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}